[Unit]
Description=Power Spring Boot App
After=network.target mysqld.service

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/apps/backend
ExecStart=/usr/bin/java -jar /home/ec2-user/apps/backend/app.jar
Restart=always
RestartSec=5
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=DB_URL=jdbc:mysql://localhost:3306/personal_project?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
Environment=DB_USERNAME=appuser
Environment=DB_PASSWORD=change-me
Environment=CORS_ALLOWED_ORIGINS=http://localhost:9090

[Install]
WantedBy=multi-user.target
